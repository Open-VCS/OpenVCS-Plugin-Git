{
  "name": "@openvcs/git-plugin",
  "version": "0.1.0",
  "description": "OpenVCS Git plugin - Node.js runtime",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "build:plugin": "tsc -p tsconfig.json",
    "build": "node ./node_modules/@openvcs/sdk/bin/openvcs.js build",
    "dist": "node ./node_modules/@openvcs/sdk/bin/openvcs.js dist --plugin-dir . --out dist"
  },
  "dependencies": {
    "@openvcs/sdk": "^0.2.14"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  },
  "files": [
    "bin/",
    "src/",
    "openvcs.plugin.json",
    "tsconfig.json",
    "README.md",
    "ARCHITECTURE.md",
    "icon.png",
    "LICENSE"
  ]
}
