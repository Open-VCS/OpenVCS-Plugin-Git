{
  "id": "openvcs.git",
  "name": "Git",
  "author": "OpenVCS Team",
  "category": "backend",
  "description": "Provides Git support as an OpenVCS plugin.",
  "version": "0.2.0",
  "default_enabled": true,
  "entry": "entry.js",
  "capabilities": ["ui.notifications", "process.exec", "workspace.write"],
  "module": {
    "exec": "openvcs-git-plugin.wasm",
    "vcs_backends": [
      { "id": "git", "name": "Git" }
    ]
  }
}
