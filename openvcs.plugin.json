{
  "id": "openvcs.git",
  "name": "Git Backends",
  "category": "backend",
  "description": "Provides Git backends (system git and libgit2) as an OpenVCS plugin.",
  "version": "0.1.0",
  "default_enabled": true,
  "capabilities": ["ui.notifications"],
  "backend": {
    "exec": "openvcs-git-plugin",
    "provides": [
      { "id": "git-system", "name": "System" },
      { "id": "git-libgit2", "name": "Libgit2" }
    ]
  },
  "functions": {
    "exec": "openvcs-git-functions"
  }
}
